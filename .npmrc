# Реестр пакетов. Активен ровно один блок — второй закомментирован.
#
# По умолчанию — банковский Nexus. strict-ssl отключён из-за MITM-сертификата
# периметра: без этого npm/pnpm падают на UNABLE_TO_VERIFY_LEAF_SIGNATURE.
registry=https://nexus.isb/repository/npmjs-npm-proxy/
strict-ssl=false

# Публичный npm — для работы снаружи периметра, ставится без VPN и с обычной
# проверкой TLS. Включать так: закомментировать две строки выше и снять
# комментарий со строки ниже.
#registry=https://registry.npmjs.org/
#
# pnpm-lock.yaml к реестру не привязан (в нём только integrity-хеши, без URL),
# поэтому переключение туда-обратно не требует переустановки с нуля.
