# nginx-конфиг plchat. ${NGINX_PORT} подставляется envsubst'ом на старте контейнера;
# остальные $-переменные — nginx-овые (NGINX_ENVSUBST_FILTER=^NGINX_ их не трогает).

# Кеш вычисляется по $uri, чтобы add_header остался только на уровне server:
# в location со своим add_header серверные заголовки не наследуются.
map $uri $cache_control {
    default           "no-cache";
    ~^/widget/assets/ "public, max-age=31536000, immutable";
}

server {
    listen      ${NGINX_PORT};
    server_name _;

    server_tokens off;

    # Относительный Location: за TLS-терминирующим Ingress абсолютный увёл бы на http://<host>:8080.
    absolute_redirect off;

    root /usr/share/nginx/html;

    # Защита от clickjacking. То же правило — в bridge.ts (проверка origin для postMessage),
    # менять только вместе.
    set $csp "frame-ancestors https://otpbank.ru https://*.otpbank.ru";

    # Заводя в location собственный add_header, подключи этот файл там повторно.
    include /etc/nginx/snippets/security-headers.conf;
    add_header Cache-Control $cache_control always;

    # Liveness-проба для оркестратора / docker healthcheck.
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location = /loader.js {
        try_files $uri =404;
    }

    location ~ \.map$ {
        return 404;
    }

    location = /index.html {
        return 404;
    }

    # Корень → виджет (живёт под base="/widget/").
    location = / {
        return 302 /widget/;
    }

    location /widget/assets/ {
        access_log off;
        try_files  $uri =404;
    }

    # SPA виджета: статичный файл или fallback на index.html.
    location /widget/ {
        try_files $uri $uri/ /widget/index.html;
    }

    gzip            on;
    gzip_vary       on;
    gzip_comp_level 6;
    gzip_min_length 1024;
    gzip_types      text/css application/javascript application/json image/svg+xml;
}
