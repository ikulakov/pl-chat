# nginx-конфиг bankchat. ${NGINX_PORT} подставляется envsubst'ом на старте контейнера;
# остальные $-переменные — nginx-овые (NGINX_ENVSUBST_FILTER=^NGINX_ их не трогает).

server {
    listen      ${NGINX_PORT};
    server_name _;

    root  /usr/share/nginx/html;
    index index.html;

    # Защита от clickjacking: встраивать виджет может только сам otpbank.ru и его поддомены.
    # То же правило продублировано в bridge.ts (проверка origin для postMessage) — два слоя
    # одной защиты, менять только вместе. Здесь домен задаётся один раз, в $csp.
    set $csp "frame-ancestors https://otpbank.ru https://*.otpbank.ru";
    add_header Content-Security-Policy $csp always;

    # Liveness-проба для оркестратора / docker healthcheck.
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # loader.js — IIFE-скрипт для встраивания. Без content-hash в имени,
    # поэтому no-cache: браузер ревалидирует при каждом обращении.
    location = /loader.js {
        add_header Cache-Control "no-cache";
        add_header Content-Security-Policy $csp always;
        try_files  $uri =404;
    }

    # Корень → виджет (живёт под base="/widget/").
    location = / {
        return 302 $scheme://$http_host/widget/;
    }

    # Хешированные ассеты виджета (vite content-hash в имени) — иммутабельный долгий кеш.
    location /widget/assets/ {
        access_log off;
        expires    1y;
        add_header Cache-Control "public, immutable";
        add_header Content-Security-Policy $csp always;
        try_files  $uri =404;
    }

    # SPA виджета: статичный файл или fallback на index.html. index.html — без кеша.
    location /widget/ {
        add_header Cache-Control "no-cache";
        add_header Content-Security-Policy $csp always;
        try_files  $uri $uri/ /widget/index.html;
    }

    gzip            on;
    gzip_vary       on;
    gzip_min_length 1024;
    gzip_types      text/css application/javascript application/json image/svg+xml;
}
